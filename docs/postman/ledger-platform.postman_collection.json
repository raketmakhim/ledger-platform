{
  "info": {
    "name": "Ledger Platform",
    "description": "Requests for the endpoints built so far. Start the app (./task up), then load the demo accounts: see docs/postman/seed-accounts.sql. Health checks, Accounts and Transfers, each split into a Happy path and a Sad path (the error cases). Every account and transfer request says who is calling in the X-Customer-Id header (the customerId variable), which stands in for a real login. Each request has tests, so the collection runner shows what passed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "fromAccountId",
      "value": "11111111-1111-7111-8111-111111111111"
    },
    {
      "key": "toAccountId",
      "value": "22222222-2222-7222-8222-222222222222"
    },
    {
      "key": "customerId",
      "value": "33333333-3333-7333-8333-333333333333"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health (overall)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('app is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));",
                  "pm.test('no details are shown', () => pm.expect(pm.response.json().components).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Liveness (is the app running?)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health/liveness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "liveness"
              ]
            },
            "description": "The app alone. It stays UP when the database is down, so an orchestrator does not restart the app for a database problem."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('liveness is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness (can it take traffic?)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health/readiness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "readiness"
              ]
            },
            "description": "Needs the database. It returns 503 when Postgres cannot be reached, so a load balancer stops sending requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('readiness is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Happy path",
          "item": [
            {
              "name": "Open a GBP account (201)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "X-Customer-Id",
                    "value": "{{customerId}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/accounts",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "accounts"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"currency\": \"GBP\"\n}"
                },
                "description": "Opens an empty account for the customer in the X-Customer-Id header."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 201', () => pm.response.to.have.status(201));",
                      "const body = pm.response.json();",
                      "pm.collectionVariables.set('newAccountId', body.id);",
                      "pm.test('Location points at the account', () => pm.expect(pm.response.headers.get('Location')).to.eql('/accounts/' + body.id));",
                      "pm.test('it is empty and active', () => {",
                      "  pm.expect(body.balance).to.eql('0.00');",
                      "  pm.expect(body.status).to.eql('ACTIVE');",
                      "  pm.expect(body.currency).to.eql('GBP');",
                      "});"
                    ]
                  }
                }
              ]
            },
            {
              "name": "View it (200)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-Customer-Id",
                    "value": "{{customerId}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/accounts/{{newAccountId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "accounts",
                    "{{newAccountId}}"
                  ]
                },
                "description": "Run after 'Open a GBP account': it reads the account that request created."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "pm.test('it is the account that was opened', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('newAccountId')));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "List my accounts (200)",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "X-Customer-Id",
                    "value": "{{customerId}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/accounts",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "accounts"
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 200', () => pm.response.to.have.status(200));",
                      "pm.test('the list is an array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                      "pm.test('it holds only my accounts, oldest first', () => {",
                      "  const ids = pm.response.json().map(a => a.id);",
                      "  pm.expect(ids).to.include(pm.collectionVariables.get('fromAccountId'));",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
