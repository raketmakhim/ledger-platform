                    ]
                  }
                }
              ]
            },
            {
              "name": "No caller (401)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/transfers",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "transfers"
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"from\": \"{{fromAccountId}}\",\n  \"to\": \"{{toAccountId}}\",\n  \"amount\": \"1.00\",\n  \"currency\": \"GBP\",\n  \"reference\": \"{{$guid}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 401', () => pm.response.to.have.status(401));",
                      "pm.test('type is unauthenticated', () => pm.expect(pm.response.json().type).to.eql('urn:ledger:problem:unauthenticated'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Reuse the same reference (409)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "X-Customer-Id",
                    "value": "{{customerId}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"from\": \"{{fromAccountId}}\",\n  \"to\": \"{{toAccountId}}\",\n  \"amount\": \"10.00\",\n  \"currency\": \"GBP\",\n  \"reference\": \"{{lastReference}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/transfers",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "transfers"
                  ]
                },
                "description": "Sends a transfer with a new reference, then this request sends the same reference again. The second one is refused and moves no money."
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const reference = pm.variables.replaceIn('{{$guid}}');",
                      "const first = {",
                      "  from: pm.collectionVariables.get('fromAccountId'),",
                      "  to: pm.collectionVariables.get('toAccountId'),",
                      "  amount: '1.00',",
                      "  currency: 'GBP',",
                      "  reference: reference",
                      "};",
                      "pm.sendRequest({",
                      "  url: pm.collectionVariables.get('baseUrl') + '/transfers',",
                      "  method: 'POST',",
                      "  header: { 'Content-Type': 'application/json', 'X-Customer-Id': pm.collectionVariables.get('customerId') },",
                      "  body: { mode: 'raw', raw: JSON.stringify(first) }",
                      "}, (error, response) => {",
                      "  if (error || response.code !== 201) {",
                      "    throw new Error('The first transfer should return 201, got ' + (error || response.code));",
                      "  }",
                      "  pm.collectionVariables.set('lastReference', reference);",
                      "});"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 409', () => pm.response.to.have.status(409));",
                      "pm.test('type is duplicate-reference', () => pm.expect(pm.response.json().type).to.eql('urn:ledger:problem:duplicate-reference'));"
                    ]
                  }
                }
              ]
            },
