{
  "info": {
    "name": "Ledger Platform",
    "description": "Requests for the endpoints built so far. Start the app (./task up), then load the two demo accounts: see docs/postman/seed-accounts.sql. Health checks, then Transfers split into Happy path and Sad path (the error cases). Each request has tests, so the collection runner shows what passed. The endpoint has no authentication yet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "fromAccountId",
      "value": "11111111-1111-7111-8111-111111111111"
    },
    {
      "key": "toAccountId",
      "value": "22222222-2222-7222-8222-222222222222"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health (overall)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('app is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));",
                  "pm.test('no details are shown', () => pm.expect(pm.response.json().components).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Liveness (is the app running?)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health/liveness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "liveness"
              ]
            },
            "description": "The app alone. It stays UP when the database is down, so an orchestrator does not restart the app for a database problem."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('liveness is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness (can it take traffic?)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health/readiness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "readiness"
              ]
            },
            "description": "Needs the database. It returns 503 when Postgres cannot be reached, so a load balancer stops sending requests."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('readiness is UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Transfers",
      "item": [
        {
          "name": "Happy path",
          "item": [
            {
              "name": "Transfer 10.00 GBP (201)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"from\": \"{{fromAccountId}}\",\n  \"to\": \"{{toAccountId}}\",\n  \"amount\": \"10.00\",\n  \"currency\": \"GBP\",\n  \"reference\": \"{{$guid}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/transfers",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "transfers"
                  ]
                },
                "description": "Moves money between the two demo accounts. The reference is a new UUID each time, because it will become the duplicate check."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 201', () => pm.response.to.have.status(201));",
                      "const body = pm.response.json();",
                      "pm.test('Location points at the entry', () => pm.expect(pm.response.headers.get('Location')).to.eql('/journal-entries/' + body.id));",
                      "pm.test('it is a TRANSFER with two postings', () => {",
                      "  pm.expect(body.type).to.eql('TRANSFER');",
                      "  pm.expect(body.postings.length).to.eql(2);",
                      "});",
                      "pm.test('money leaves from and arrives at to', () => {",
                      "  const out = body.postings.find(p => p.accountId === pm.collectionVariables.get('fromAccountId'));",
                      "  const into = body.postings.find(p => p.accountId === pm.collectionVariables.get('toAccountId'));",
                      "  pm.expect(out.amount).to.eql('-10.00');",
                      "  pm.expect(into.amount).to.eql('10.00');",
                      "});"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Sad path",
          "item": [
            {
              "name": "Reuse the same reference (409)",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"from\": \"{{fromAccountId}}\",\n  \"to\": \"{{toAccountId}}\",\n  \"amount\": \"10.00\",\n  \"currency\": \"GBP\",\n  \"reference\": \"{{lastReference}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/transfers",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "transfers"
                  ]
                },
                "description": "Sends a transfer with a new reference, then this request sends the same reference again. The second one is refused and moves no money."
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const reference = pm.variables.replaceIn('{{$guid}}');",
                      "const first = {",
                      "  from: pm.collectionVariables.get('fromAccountId'),",
                      "  to: pm.collectionVariables.get('toAccountId'),",
                      "  amount: '1.00',",
                      "  currency: 'GBP',",
                      "  reference: reference",
                      "};",
                      "pm.sendRequest({",
                      "  url: pm.collectionVariables.get('baseUrl') + '/transfers',",
                      "  method: 'POST',",
                      "  header: { 'Content-Type': 'application/json' },",
                      "  body: { mode: 'raw', raw: JSON.stringify(first) }",
                      "}, (error, response) => {",
                      "  if (error || response.code !== 201) {",
                      "    throw new Error('The first transfer should return 201, got ' + (error || response.code));",
                      "  }",
                      "  pm.collectionVariables.set('lastReference', reference);",
                      "});"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('status is 409', () => pm.response.to.have.status(409));",
                      "pm.test('type is duplicate-reference', () => pm.expect(pm.response.json().type).to.eql('urn:ledger:problem:duplicate-reference'));"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Not enough money (422)",
