                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"from\": \"{{fromAccountId}}\",\n  \"to\": \"{{fromAccountId}}\",\n  \"amount\": \"1.00\",\n  \"currency\": \"GBP\",\n  \"reference\": \"{{$guid}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/transfers",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
